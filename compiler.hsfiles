{-# START_FILE .vscode/tasks.json #-}

{
  // Automatically created by phoityne-vscode extension.

  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "panel": "new"
  },
  "tasks": [
    {
      // F7
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "haskell build",
      "type": "shell",
      "command": "stack build"
    },
    {
      // F6
      "group": "build",
      "type": "shell",
      "label": "haskell clean & build",
      "command": "stack clean && stack build"
    },
    {
      // F8
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "type": "shell",
      "label": "haskell test",
      //"command": "cabal test"
      "command": "stack test"
    },
    {
      // F6
      "isBackground": true,
      "type": "shell",
      "label": "haskell watch",
      "command": "stack build --test --no-run-tests --file-watch"
    }
  ]
}


{-# START_FILE README.md #-}
# HMC -- Human-Made Compiler

## Commands

- **Test:** `stack test`
- **Run:** `stack run`
- **Build:** `stack build`

{-# START_FILE app/Main.hs #-}
{- |
Module       : Main
Description  : The main program for the compiler: takes command-line args and runs the compiler
-}
module Main
    ( main
    ) where

import           Args                   (Options (..), options)

import           CompilerMonad          (runCompilerM)

import           CompilerTypes          (buildContext, defaultCompilerState)

import           Control.Monad          (unless)

import           Phases                 (phases)

import           System.Console.CmdArgs (cmdArgs)


main :: IO ()
main = do
    -- Get command line options
    opts <- cmdArgs options

    -- Get the expression and build compiler context from options
    let context = buildContext opts

    -- Run the compiler monad with the given context
    (result, finalLog) <- runCompilerM context defaultCompilerState phases (input opts)

    -- Output the final log
    unless (null finalLog) $
        print finalLog

    -- Print the result of the compilation
    case result of
        Left errMsg -> putStrLn $ "Compilation failed: " ++ errMsg
        Right (output, _) -> do
            putStrLn output

{-# START_FILE hie.yaml #-}
cradle:
  stack:
    - path: "./src"
      component: "{{name}}:lib"

    - path: "./app"
      component: "{{name}}:exe:{{name}}-exe"

    - path: "./test"
      component: "{{name}}:test:{{name}}-test"

{-# START_FILE {{name}}.cabal #-}
cabal-version: 1.12

-- This file has been generated from package.yaml by hpack version 0.38.1.
--
-- see: https://github.com/sol/hpack

name:           {{name}}
version:        0.0.0
description:    Please see the README file
author:         Author name here
maintainer:     Author name here
build-type:     Simple
extra-source-files:
    README.md

library
  exposed-modules:
      Args
      AST
      CompilerMonad
      CompilerTypes
      Lexer
      Optimizer
      Parser
      Phases
      Tokens
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-uni-patterns -Wincomplete-record-updates -Wmissing-export-lists -Wpartial-fields -Wredundant-constraints -fhide-source-paths -freverse-errors
  build-tools:
      alex
    , happy
  build-depends:
      array
    , base >=4.7 && <5
    , cmdargs
    , containers
    , mtl
    , process
  default-language: Haskell2010

executable {{name}}-exe
  main-is: Main.hs
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-uni-patterns -Wincomplete-record-updates -Wmissing-export-lists -Wpartial-fields -Wredundant-constraints -fhide-source-paths -freverse-errors -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , cmdargs
    , containers
    , {{name}}
    , mtl
    , process
  default-language: Haskell2010

test-suite {{name}}-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      ParserSpec
      TokenSpec
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-uni-patterns -Wincomplete-record-updates -Wmissing-export-lists -Wpartial-fields -Wredundant-constraints -fhide-source-paths -freverse-errors -threaded -rtsopts -with-rtsopts=-N
  build-tool-depends:
      hspec-discover:hspec-discover
  build-depends:
      QuickCheck
    , base >=4.7 && <5
    , cmdargs
    , containers
    , hspec
    , {{name}}
    , mtl
    , process
  default-language: Haskell2010

{-# START_FILE package.yaml #-}
# cspell: disable
name: {{name}}
author: "Author name here"

extra-source-files:
  - README.md

# To avoid duplicated efforts in documentation and dealing with the
# complications of embedding Haddock markup inside cabal files, it is
# common to point users to the README.md file.
description: Please see the README file

dependencies:
  - base >= 4.7 && < 5
  - mtl
  - cmdargs
  - containers
  - process

spec-version: 0.36.0

ghc-options:
  - -Wall
  - -Wcompat
  - -Widentities
  - -Wincomplete-uni-patterns
  - -Wincomplete-record-updates
  - -Wmissing-export-lists
  - -Wpartial-fields
  - -Wredundant-constraints
  - -fhide-source-paths
  - -freverse-errors

library:
  source-dirs: src
  dependencies:
    - array
  build-tools:
    - alex
    - happy

executables:
  {{name}}-exe:
    main: Main.hs
    source-dirs: app
    ghc-options:
      - -threaded
      - -rtsopts
      - -with-rtsopts=-N
    dependencies:
      - {{name}}

tests:
  {{name}}-test:
    main: Spec.hs
    source-dirs: test
    ghc-options:
      - -threaded
      - -rtsopts
      - -with-rtsopts=-N
    dependencies:
      - {{name}}
      - hspec
      - QuickCheck
    build-tools:
      - hspec-discover

{-# START_FILE src/AST.hs #-}
{- |
Module       : AST
Description  : Intermediate representation for the program
-}
module AST
    ( AST (..)
    ) where


data AST = AST

{-# START_FILE src/Args.hs #-}
{-# LANGUAGE DeriveDataTypeable #-}

module Args
    ( Options (..)
    , defaultOptions
    , options
    ) where

import           Data.Data              (Data, Typeable)

import           System.Console.CmdArgs (argPos, def, help, name, program, summary, typ,
                                         (&=))

-- | Data structure to hold command line options
data Options
  = Options
      { input       :: String
        -- ^ The string to process
      , printTokens :: Bool
        -- ^ Whether to print the token list
      , printAst    :: Bool
        -- ^ Whether to print the AST
      , optimizeAst :: Bool
        -- ^ Whether to optimize the AST
      , showState   :: Bool
        -- ^ Whether to show the compiler state at the end of the program
      }
  deriving (Data, Eq, Show, Typeable)

-- | Command line options
options :: Options
options =
    Options
        { input = def &= argPos 0 &= typ "INPUT"
        , printTokens = False &= name "t" &= help "Print the token list"
        , printAst = False &= name "a" &= help "Print the AST"
        , optimizeAst = False &= name "o" &= help "Optimize the AST"
        , showState = False &= name "s" &= help "Show the compiler state at the end of the program"
        }
        &= program "hmc"
        &= summary "hmc - a human-made compiler"

-- | Default options
defaultOptions :: Options
defaultOptions =
    Options
        { input = ""
        , printTokens = False
        , printAst = False
        , optimizeAst = False
        , showState = False
        }

{-# START_FILE src/CompilerMonad.hs #-}
{- |
Module       : CompilerMonad
Description  : The compiler's type, and a function for running the compiler
-}
module CompilerMonad
    ( CompilerM
    , runCompilerM
    , throwError
    , (>=>)
    ) where

import           CompilerTypes        (CompilerContext, CompilerError, CompilerLog,
                                       CompilerState)

import           Control.Monad        ((>=>))
import           Control.Monad.Except (ExceptT, runExceptT, throwError)
import           Control.Monad.RWS    (RWST, runRWST)

-----------------------------------------------------------------------------------------
-- | Definition of the compiler monad
--
--  - Except: error handling
--  - Reader: immutable CompilerContext
--  - Writer: accumulated LogEntries
--  - State: mutable CompilerState
--  - IO: for file I/O and other side effects
--
-- Using RWST to combine Reader, Writer, and State into a single transformer
-----------------------------------------------------------------------------------------
type CompilerM = ExceptT CompilerError (RWST CompilerContext CompilerLog CompilerState IO)

-- | Run the compiler monad with a given context and initial state
runCompilerM :: CompilerContext -> CompilerState -> (a -> CompilerM b) -> a -> IO (Either CompilerError (b, CompilerState), CompilerLog)
runCompilerM context state m input = do
    (result, finalState, finalLog) <- runRWST (runExceptT (m input)) context state
    return $ case result of
        Left err    -> (Left err, finalLog)
        Right value -> (Right (value, finalState), finalLog)

{-# START_FILE src/CompilerTypes.hs #-}
{- |
Module       : CompilerTypes
Description  : Definitions of types used by the compiler monad
-}
module CompilerTypes
    ( CompilerContext (..)
    , CompilerError
    , CompilerLog
    , CompilerResult
    , CompilerState (..)
    , LogEntry
    , buildContext
    , defaultCompilerContext
    , defaultCompilerState
    ) where

import           Args (Options (..), defaultOptions, input)

-----------------------------------------------------------------------------------------
-- Context (readable)
-----------------------------------------------------------------------------------------

-- | Stores information that the compiler can use to do its work
data CompilerContext
  = CompilerContext
      { configInputStr :: String
        -- ^ The input string to compile
      , configOptions  :: Options
        -- ^ The compiler options
      }
  deriving (Eq, Show)

-- | A default, empty context
defaultCompilerContext :: CompilerContext
defaultCompilerContext =
  CompilerContext
    { configInputStr = ""
    , configOptions = defaultOptions
    }

-- | Build a 'CompilerContext' from command line 'Options'
buildContext :: Options -> CompilerContext
buildContext opts =
  CompilerContext
    { configInputStr = input opts
    , configOptions = opts
    }

-----------------------------------------------------------------------------------------
-- The result of the compiler
-----------------------------------------------------------------------------------------

-- | The result of the compiler
type CompilerResult = String

-----------------------------------------------------------------------------------------
-- State (writeable)
-----------------------------------------------------------------------------------------

-- | Information the compiler can read and write
--
--  NOTE: For this compiler, we probably don't need any state, so this is an empty data
--  structure. You can change this, though, if you would like to keep track of some state!
data CompilerState = CompilerState
  deriving (Eq, Show)

-- | The default initial compiler state
defaultCompilerState :: CompilerState
defaultCompilerState =
  CompilerState

-----------------------------------------------------------------------------------------
-- Logging
-----------------------------------------------------------------------------------------

-- | A log for the compiler to write to
type CompilerLog = [LogEntry]

-- | An entry in the log
type LogEntry = String

-----------------------------------------------------------------------------------------
-- Errors
-----------------------------------------------------------------------------------------

-- | A compiler error
type CompilerError = String

