{-# START_FILE test/ParserSpec.hs #-}
{-# OPTIONS_GHC -Wno-unused-imports -Wno-unused-top-binds #-}
{- |
Module       : ParserSpec
Description  : Tests for the parser
-}
module ParserSpec
    ( spec
    ) where


import           AST           (AST (..))

import           CompilerMonad (runCompilerM, (>=>))

import           CompilerTypes (CompilerContext (..), defaultCompilerContext,
                                defaultCompilerState)

import           Phases        (parsePhase, tokenizePhase)

import           Test.Hspec    (Spec, describe, it, pendingWith, shouldBe)


-- | Helper function to run the parser in the CompilerMonad and extract the result
--
--   You can use this function in your tests, like so:
--
--    it "parses addition" $ do
--      result <- runParserIO "1 + 2"
--      result `shouldBe` Right (Plus (Int 1) (Int 2
--
runParserIO :: String -> IO (Either String AST)
runParserIO input = do
    let context = defaultCompilerContext { configInputStr = input }
    let state = defaultCompilerState
    (result, _) <- runCompilerM context state (tokenizePhase >=> parsePhase) input
    return $ case result of
      Left err       -> Left err
      Right (ast, _) -> Right ast

