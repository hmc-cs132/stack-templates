{-# START_FILE src/Phases.hs #-}
{- |
Module       : Phases
Description  : Definitions of the phases of the compiler
-}
module Phases
    ( emitPhase
    , optimizePhase
    , parsePhase
    , phases
    , tokenizePhase
    ) where

import           AST           (AST (..))

import           CompilerMonad (CompilerM, (>=>))

import           CompilerTypes (CompilerResult)

import           Tokens        (Token)

-- | The compilation phases
phases :: String -> CompilerM CompilerResult
phases = tokenizePhase >=> parsePhase >=> optimizePhase >=> emitPhase

-- | Tokenization phase
tokenizePhase :: String -> CompilerM [Token]
tokenizePhase _ = return [] -- placeholder implementation

-- | Parsing phase
parsePhase :: [Token] -> CompilerM AST
parsePhase _ = return undefined-- placeholder implementation

-- | Optimization phase
optimizePhase :: AST -> CompilerM AST
optimizePhase ast = return  ast -- placeholder implementation

-- | Compilation phase
emitPhase :: AST -> CompilerM CompilerResult
emitPhase _ = return undefined -- placeholder implementation

